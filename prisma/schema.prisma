// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String     @id @default(cuid())
  name     String     @unique
  email    String     @unique
  password String?
  isAdmin  Boolean    @default(false)
  bio      String?
  avatar   String?
  games    UserGame[]

  posts           ForumPost[]
  threadsAuthored ForumThread[] @relation("ThreadAuthor")
  lastPostThreads ForumThread[] @relation("LastPostBy")
  postsDeleted    ForumPost[]   @relation("PostDeletedBy")
}

model Console {
  id    String @id @default(cuid())
  name  String @unique
  games Game[]
}

model Game {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  coverImage  String
  developer   String
  publisher   String
  releaseDate DateTime?
  console     Console?  @relation(fields: [consoleId], references: [id])
  consoleId   String?

  screenshots  String[]
  achievements Achievement[]
  users        UserGame[]

  createdAt DateTime @default(now())
}

model Achievement {
  id              String            @id @default(cuid())
  title           String
  description     String
  image           String?
  game            Game              @relation(fields: [gameId], references: [id])
  gameId          String
  UserAchievement UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userGame      UserGame    @relation(fields: [userGameId], references: [id])
  userGameId    String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  earnedAt      DateTime    @default(now())

  @@unique([userGameId, achievementId])
}

model UserGame {
  id     String  @id @default(cuid())
  userId String
  gameId String
  owned  Boolean @default(false)

  user         User              @relation(fields: [userId], references: [id])
  game         Game              @relation(fields: [gameId], references: [id])
  achievements UserAchievement[]

  @@unique([userId, gameId])
}

model ForumCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  position  Int             @default(0) // ordering on /forum
  subforums ForumSubforum[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumSubforum {
  id         String        @id @default(cuid())
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  name        String
  slug        String
  description String? // short line under the subforum title
  position    Int     @default(0) // ordering within category

  threads ForumThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug]) // same slug can exist in different categories
}

model ForumThread {
  id         String        @id @default(cuid())
  subforum   ForumSubforum @relation(fields: [subforumId], references: [id], onDelete: Cascade)
  subforumId String

  // Named relation to User as the author
  author   User   @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  title  String
  pinned Boolean @default(false)
  locked Boolean @default(false)

  lastPostAt   DateTime @default(now())
  // Named relation "LastPostBy" must have a back-rel on User (added above)
  lastPostBy   User?    @relation("LastPostBy", fields: [lastPostById], references: [id])
  lastPostById String?

  posts ForumPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subforumId, pinned, lastPostAt])
  @@index([subforumId, lastPostAt])
  @@index([authorId])
}

model ForumPost {
  id       String      @id @default(cuid())
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  content String

  // Edits: author-only
  editedAt  DateTime?
  editCount Int       @default(0)

  // Admin delete (soft delete with reason)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     User?     @relation("PostDeletedBy", fields: [deletedById], references: [id])
  deletedById   String?
  deletedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  @@index([authorId])
}
